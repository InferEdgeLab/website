---
import { site, entity } from '../data/site';
import Logo from './Logo.astro';
import Motto from './Motto.astro';
---
<footer class="footer">
  <div class="container foot-top">
    <div>
      <a class="brand" href="/" aria-label={`${site.name} home`}><Logo size={32} /></a>
      <p>{entity.SHORT}</p>
      <Motto size="sm" />
    </div>
    <div class="links">
      {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/contact">Contact</a>
    </div>
  </div>
  <div class="container foot-bottom">
    <span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span>
    <span><a href="/privacy">Privacy</a><a href="/terms">Terms</a></span>
  </div>
</footer>

<style>
.footer{border-top:1px solid var(--line);padding:38px 0 22px;background:#fcfafd}
.foot-top{display:flex;justify-content:space-between;align-items:center;gap:24px}
.footer .brand{display:inline-flex}
.foot-top p{font-size:13px;color:var(--muted);margin:12px 0 14px}
.links{display:flex;justify-content:flex-end;flex-wrap:wrap;gap:24px}
.links a,.foot-bottom{font-size:12px;color:var(--muted)}
.links a:hover,.foot-bottom a:hover{color:var(--blue)}
.foot-bottom{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:18px;margin-top:28px}
.foot-bottom span:last-child{display:flex;gap:20px}
@media(max-width:700px){.foot-top{flex-direction:column;align-items:flex-start}.links{justify-content:flex-start}.foot-bottom{gap:12px;flex-direction:column}}
</style>
