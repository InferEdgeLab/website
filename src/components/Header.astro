---
import { site } from '../data/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}><Logo /></a>
    <nav class="nav" aria-label="Main navigation">
      {site.navigation.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="btn btn-primary nav-cta" href="/contact">Talk to us <span>→</span></a>
    <button class="menu" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav">☰</button>
  </div>
  <div class="mobile-nav" id="mobile-nav" hidden>
    {site.navigation.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <a href="/contact">Talk to us</a>
  </div>
</header>

<style>
.header{height:76px;border-bottom:1px solid transparent;background:#ffffffcc;backdrop-filter:saturate(1.6) blur(14px);-webkit-backdrop-filter:saturate(1.6) blur(14px);position:sticky;top:0;z-index:20;view-transition-name:site-header;transition:box-shadow .3s ease,border-color .3s ease,background .3s ease}
.header.scrolled{background:#ffffffeb;border-bottom-color:#e6ebf4;box-shadow:0 8px 24px rgba(46,20,70,.06)}
.bar{height:100%;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center}
.nav{display:flex;gap:30px;margin-left:auto;margin-right:24px}
.nav a{font-size:13px;font-weight:600;color:#52617d;position:relative;transition:color .2s ease}
.nav a::after{content:'';position:absolute;left:0;right:0;bottom:-8px;height:2px;border-radius:2px;background:linear-gradient(90deg,#5b2a86,#ff7a59);transform:scaleX(0);transform-origin:left;transition:transform .3s var(--ease)}
.nav a:hover::after,.nav a[aria-current='page']::after{transform:scaleX(1)}
.nav a:hover,.nav a[aria-current='page']{color:var(--blue)}
.nav-cta{padding:11px 16px;font-size:12px}
.menu,.mobile-nav{display:none}
@media(max-width:760px){
  .header{height:66px}
  .nav,.nav-cta{display:none}
  .menu{display:block;border:1px solid var(--line);background:#fff;border-radius:8px;padding:8px 11px;color:var(--ink);font-size:18px;cursor:pointer}
  .mobile-nav{display:flex;position:absolute;top:100%;left:0;right:0;background:#fff;border-bottom:1px solid var(--line);padding:16px 24px;flex-direction:column;gap:18px;box-shadow:0 14px 30px rgba(46,20,70,.08)}
  .mobile-nav[hidden]{display:none}
  .mobile-nav a{font-weight:600;font-size:14px}
  .mobile-nav a[aria-current='page']{color:var(--blue)}
}
</style>

<script>
const header = document.querySelector<HTMLElement>('.header');
const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 12);
onScroll();
window.addEventListener('scroll', onScroll, { passive: true });

const menu = document.querySelector('.menu');
const panel = document.querySelector('.mobile-nav');
menu?.addEventListener('click', () => {
  const open = menu.getAttribute('aria-expanded') === 'true';
  menu.setAttribute('aria-expanded', String(!open));
  menu.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation');
  panel?.toggleAttribute('hidden', open);
});
</script>
