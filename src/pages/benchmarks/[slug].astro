---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { entity } from '../../data/site';

// Drafts and an empty collection both resolve to an empty array here, so this route
// builds zero pages until a real, non-draft benchmark entry exists.
export async function getStaticPaths() {
  const entries = await getCollection('benchmarks', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, datePublished, model, gpu, cloudInstance, runtimes, precisions } = entry.data;

const orgRef = { '@id': `${entity.URL}/#org` };
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      datePublished,
      description: summary,
      author: orgRef,
      publisher: orgRef,
    },
    {
      '@type': 'Dataset',
      name: title,
      description: summary,
      creator: orgRef,
      publisher: orgRef,
    },
  ],
};
---
<BaseLayout title={title} description={summary}>
  <Header />
  <main>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <section class="page-hero">
      <div class="container">
        <div class="eyebrow">BENCHMARK</div>
        <h1>{title}</h1>
        <p>{summary}</p>
      </div>
    </section>
    <section class="section">
      <div class="container bench-meta">
        <div><strong>Model</strong><span>{model}</span></div>
        <div><strong>GPU</strong><span>{gpu}</span></div>
        <div><strong>Instance</strong><span>{cloudInstance}</span></div>
        <div><strong>Runtimes</strong><span>{runtimes.join(', ')}</span></div>
        <div><strong>Precisions</strong><span>{precisions.join(', ')}</span></div>
      </div>
      <div class="container benchmark-body">
        <Content />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
.bench-meta{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;margin-bottom:40px}
.bench-meta div{padding:16px;border:1px solid var(--line);border-radius:12px}
.bench-meta strong{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--blue);margin-bottom:6px}
.bench-meta span{font-size:14px;color:var(--ink)}
.benchmark-body{font-size:15px;line-height:1.75;color:var(--muted)}
@media(max-width:900px){.bench-meta{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.bench-meta{grid-template-columns:1fr}}
</style>
