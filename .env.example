# Canonical public website origin. Defaults to https://inferedgelab.com if unset.
PUBLIC_SITE_URL=https://inferedgelab.com

# Contact form delivery. Get a free key at https://web3forms.com (no account needed)
# using hello@inferedgelab.com as the destination. While unset, the contact form
# falls back to a plain mailto: link, which is not reliable for every visitor.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional: Cloudflare Web Analytics (cookie-free, no consent banner needed).
# Get a free token at Cloudflare dashboard -> Analytics & Logs -> Web Analytics.
# While unset, no analytics script loads and the privacy notice reflects that.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
