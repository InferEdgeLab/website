---
/** Offer ladder with prices (item 5). Content lives in `offers` in src/data/site.ts. */
import { offers, pricingNote } from '../data/site';
---
<section class="section pricing" id="pricing">
  <div class="container">
    <div class="section-head reveal-on-scroll">
      <div>
        <div class="eyebrow">PRICING</div>
        <h2>Fixed prices. No surprises.</h2>
      </div>
      <p>Start free, then decide with real numbers. Every price is fixed before we start, and the audit fee is credited in full to the sprint.</p>
    </div>

    <div class="offers reveal-stagger">
      {offers.map((o) => (
        <article class:list={['card', 'offer', { featured: o.featured }]}>
          {o.featured && <span class="badge">Recommended first step</span>}
          <h3>{o.name}</h3>
          <p class="price">{o.price}{o.unit && <small>{o.unit}</small>}</p>
          <p class="summary">{o.summary}</p>
          <ul>
            {o.points.map((p) => <li><span class="tick" aria-hidden="true">✓</span>{p}</li>)}
          </ul>
          <p class="delivery">{o.delivery}</p>
          <a class:list={['btn', o.featured ? 'btn-primary' : 'btn-secondary']} href={`/contact?topic=${o.key}`}>{o.cta} →</a>
        </article>
      ))}
    </div>
    <p class="note reveal-on-scroll">{pricingNote}</p>
  </div>
</section>

<style>
.pricing{background:#fcfafd;border-top:1px solid #edf1f8}
.offers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch}
.offer{padding:28px;display:flex;flex-direction:column}
.offer.featured{border:2px solid var(--blue);box-shadow:0 22px 46px rgba(46,20,70,.13)}
.badge{align-self:flex-start;background:#f3ecf9;color:var(--blue);border-radius:30px;padding:5px 11px;font-size:11px;font-weight:700;margin-bottom:14px}
.offer h3{font:700 19px Manrope;margin:0}
.price{font:800 36px/1.1 Manrope,sans-serif;letter-spacing:-.04em;margin:14px 0 6px;color:var(--ink)}
.price small{font:600 13px 'DM Sans',sans-serif;color:var(--muted);margin-left:8px;letter-spacing:0}
.summary{color:var(--muted);font-size:14px;line-height:1.6;margin:0 0 18px}
.offer ul{list-style:none;padding:0;margin:0 0 20px;display:grid;gap:10px;flex:1;align-content:start}
.offer li{display:flex;gap:10px;font-size:13.5px;line-height:1.5;color:#3f3350}
.tick{flex:0 0 auto;width:18px;height:18px;border-radius:50%;background:#fff0eb;color:#d4553a;display:grid;place-items:center;font-size:10px;font-weight:800;margin-top:1px}
.delivery{font-size:12px;font-weight:700;color:var(--blue);margin:0 0 16px;letter-spacing:.02em}
.offer .btn{width:100%}
.note{color:var(--muted);font-size:13.5px;line-height:1.7;max-width:820px;margin:26px 0 0}
@media(max-width:960px){.offers{grid-template-columns:1fr;max-width:560px}}
</style>
